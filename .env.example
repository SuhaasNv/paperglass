# Copy to .env for local development. Never commit .env.
# Paperglass is offline by default; no variable below is required to scan a file.

# Allow network features (deep-tier model download, optional VirusTotal lookups). Default: false.
PAPERGLASS_ALLOW_NETWORK=false

# Sandbox budgets per parser call. Defaults shown.
PAPERGLASS_SANDBOX_SECONDS=5
PAPERGLASS_SANDBOX_MEMORY_MB=512
PAPERGLASS_MAX_FILE_MB=50
PAPERGLASS_MAX_PAGES=500

# REST service (UC4, v0.4.0). Not read by the library or the CLI.
PAPERGLASS_METRICS_TOKEN=change-me
PAPERGLASS_LOG_LEVEL=info

# Web backend (v0.2.0). Not read by the library or the CLI.
APP_ENV=development
PAPERGLASS_DATABASE_URL=postgresql+psycopg://paperglass:paperglass@localhost:5432/paperglass
PAPERGLASS_SESSION_SECRET=change-me-to-32-or-more-random-characters
PAPERGLASS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PAPERGLASS_RETENTION_DAYS=7
PAPERGLASS_MAX_UPLOAD_MB=25

# Frontend development server (frontend/): where Vite proxies /api and /healthz
PAPERGLASS_BACKEND_URL=http://localhost:8000
